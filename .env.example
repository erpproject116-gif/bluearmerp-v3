# =============================================================================
# Bluearm ERP v3 — environment (pick ONE location)
# =============================================================================
#
# Option A (recommended): copy to .env at repo root
# Option B (Vite default): copy to web/.env.local  ← Go API reads this too
#
# =============================================================================

# --- Supabase Dashboard → Settings → API ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret-from-same-api-page

# --- Supabase Dashboard → Settings → Database → Database password ---
# The Go API uses direct Postgres (pgx). Service role cannot replace this.
# With SUPABASE_URL + password below, DATABASE_URL is built automatically.
SUPABASE_DB_PASSWORD=your-database-password

# --- Optional overrides ---
# DATABASE_URL=postgresql://postgres:...@db.your-project.supabase.co:5432/postgres
# PORT=8080
# CORS_ORIGIN=http://localhost:5173
# --- Transactional email (API outbox: invites, digests, docs fallback) ---
# Preferred on Render free: Resend HTTPS (SMTP ports are blocked on free tier).
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=BluearmERP <noreply@yourdomain.com>
# APP_PUBLIC_URL=https://app.bluearmerp.com
# CHANGE_ALERT_JOB_SECRET=long-random-secret
# Optional: override digest recipients (comma-separated). Default = tenant owner (hourly) / owner+store_admin (daily ops).
# CHANGE_ALERT_DIGEST_TO=ops@example.com
# Cron: POST /api/v1/platform/jobs/change-alert-digest, .../daily-ops-digest,
# .../weekly-bi-digest, .../monthly-bi-digest with X-Change-Alert-Job-Secret.
# See docs/runbooks/ops-email-notifications.md
# Optional SMTP (paid host / local):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_FROM=BluearmERP <noreply@yourdomain.com>
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxx
# Note: Auth confirm/reset/OTP use Supabase Auth SMTP (Dashboard), not these vars.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT=https://YOUR-API.onrender.com/api/v1/comms/gmail/callback
# DEMO_USER_EMAIL=demo@demo.bluearm.local
# DEMO_USER_PASSWORD=DemoBluearm2026!
# Must also exist in Supabase Auth (Dashboard → Authentication → Users) with the same password.
# VITE_API_BASE_URL=https://bluearmerp-v3.onrender.com
# VITE_DEMO_SIGNIN_ENABLED=true
# Vite maps DEMO_USER_* → VITE_DEMO_USER_* for the “Try free demo” button.

# --- Public articles HTML (Vercel serverless `web/api/cms-public.ts`) ---
# Set these on Vercel → Project → Settings → Environment Variables (Production).
# Root Directory must be `web`. No trailing slash. Redeploy after changing.
# CMS_API_BASE_URL is runtime (no VITE_ prefix). Same host as VITE_API_BASE_URL.
# CMS_API_BASE_URL=https://bluearmerp-v3.onrender.com
# PUBLIC_SITE_URL=https://app.bluearmerp.com
# CMS_SITE_NAME=Bluearm
# Optional: company_code that may use Draft with Baiko (default BLUEARM).
# VITE_CMS_PUBLIC_TENANT_CODE=BLUEARM
#
# On Render (Go API), not Vercel:
# CMS_PUBLIC_TENANT_CODE=BLUEARM
# CMS_PREVIEW_SECRET=long-random-secret
# (If CMS_PREVIEW_SECRET is empty, preview tokens fall back to SUPABASE_JWT_SECRET.)

# --- Smart RFQ import — Alibaba DashScope / Qwen (server-side only) ---
# Enable Model Studio at https://modelstudio.console.alibabacloud.com/
# International endpoint (default): dashscope-intl.aliyuncs.com
# China mainland: set DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_API_KEY=sk-...
# QWEN_VL_MODEL=qwen-vl-plus
# RFQ_AI_ENABLED=true
# RFQ_AI_MAX_PAGES=10
# RFQ_AI_PAGES_PER_CALL=2
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# --- Help Assistant / Copilot (grounded answers; same DashScope key) ---
# HELP_AI_ENABLED=true
# HELP_AI_MODEL=qwen-flash
# COPILOT_ENABLED=true
# COPILOT_SMALL_MODEL=qwen-flash
# COPILOT_MEDIUM_MODEL=qwen-plus
# COPILOT_DAILY_TOKEN_CAP=500000
# QWEN_CHAT_MODEL=qwen-flash

# --- Playwright e2e (optional; also loaded from web/.env.local) ---
# E2E_DEMO_PASSWORD=DemoBluearm2026!
# E2E_BASE_URL=http://localhost:5173
# E2E_FULL_ROUTE_SMOKE=1
# E2E_BENCH_TOKEN=   # CI only
