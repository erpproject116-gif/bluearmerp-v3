# Bluearm API — Alibaba ECS / ACK environment (Sprint 2+)
# Copy values to ECS task env, Docker Compose, or Alibaba Secrets Manager.
# Sprint 1 (DashScope) vars are required for RFQ AI enhancement.

# --- Core ---
PORT=8080
MIGRATE_ON_START=true
CORS_ORIGIN=https://app.yourdomain.com
# Prefer Supabase Session pooler URI on ECS (Direct db.*.supabase.co is often IPv6-only).
DATABASE_URL=postgresql://user:pass@your-rds-host:5432/bluearm

# --- Auth (interim: Supabase) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Rate limits (per user+tenant or IP; in-process fixed window) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PUBLIC_STRICT_RPM=10
RATE_LIMIT_PUBLIC_PROVISION_RPM=30
# SPA headroom on a single ECS; raise only if normal navigation still hits 429.
RATE_LIMIT_AUTHENTICATED_RPM=300
RATE_LIMIT_EXPENSIVE_RPM=60

# --- Performance (process-local caches; see docs/adr/0004-performance-patterns.md) ---
GZIP_ENABLED=true
AUTH_CACHE_ENABLED=true
AUTH_CACHE_TTL_SECONDS=30
AUDIT_ASYNC=true
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# --- DashScope / Qwen (Sprint 1) ---
DASHSCOPE_API_KEY=sk-...
QWEN_VL_MODEL=qwen-vl-plus
RFQ_AI_ENABLED=true
RFQ_AI_MAX_PAGES=10
RFQ_AI_PAGES_PER_CALL=2
# International (default). China: https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# --- Sprint 3: object storage (not implemented yet) ---
# STORAGE_BACKEND=oss
# OSS_ENDPOINT=oss-ap-southeast-1.aliyuncs.com
# OSS_BUCKET=bluearm-files
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
