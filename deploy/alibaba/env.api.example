# Bluearm API — Alibaba ECS / ACK environment (Sprint 2+)
# Copy values to ECS task env, Docker Compose, or Alibaba Secrets Manager.
# Sprint 1 (DashScope) vars are required for RFQ AI enhancement.

# --- Core ---
PORT=8080
MIGRATE_ON_START=true
CORS_ORIGIN=https://app.yourdomain.com
DATABASE_URL=postgresql://user:pass@your-rds-host:5432/bluearm

# --- Auth (interim: Supabase) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret

# --- DashScope / Qwen (Sprint 1) ---
DASHSCOPE_API_KEY=sk-...
QWEN_VL_MODEL=qwen-vl-plus
RFQ_AI_ENABLED=true
RFQ_AI_MAX_PAGES=10
RFQ_AI_PAGES_PER_CALL=2
# International (default). China: https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# --- Sprint 3: object storage (not implemented yet) ---
# STORAGE_BACKEND=oss
# OSS_ENDPOINT=oss-ap-southeast-1.aliyuncs.com
# OSS_BUCKET=bluearm-files
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
