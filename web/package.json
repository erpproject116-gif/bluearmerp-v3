{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:core-interactions": "playwright test e2e/core-interactions.spec.ts --project=chromium",
    "test:e2e:routes:full": "node e2e/scripts/run-full-route-smoke.mjs",
    "test:e2e:live:read-only": "playwright test --project=read-only",
    "test:e2e:live:reversible": "playwright test --project=reversible",
    "test:e2e:live:posting": "playwright test --project=posting",
    "test:e2e:auth:save": "playwright test e2e/auth-save.spec.ts --project=auth-save",
    "e2e:routes:extract": "node e2e/scripts/extract-app-routes.mjs",
    "e2e:coverage:manifest": "node e2e/scripts/build-coverage-manifest.mjs",
    "e2e:tickets:draft": "node e2e/scripts/draft-support-tickets.mjs",
    "e2e:tickets:submit": "node e2e/scripts/submit-support-tickets.mjs",
    "e2e:report": "node e2e/scripts/generate-run-report.mjs",
    "dead-code": "ts-prune -p tsconfig.app.json",
    "export:help-corpus": "vitest run src/modules/help-assistant/exportHelpCorpus.test.ts src/modules/help-assistant/exportGoldenQueries.test.ts",
    "format:cms-articles": "vitest run src/modules/cms/formatCmsArticles.export.test.ts"
  },
  "dependencies": {
    "@solidjs/router": "^0.16.1",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/solid-query": "^5.101.0",
    "@thisbeyond/solid-dnd": "^0.7.5",
    "chart.js": "^4.5.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.1.200",
    "solid-js": "^1.9.12",
    "tailwindcss": "^4.3.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.51.0",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^3.0.9",
    "workbox-window": "^7.4.1"
  }
}
